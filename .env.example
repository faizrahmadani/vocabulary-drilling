# Environment variable NAMES only — no values. See README.md for setup.
# Backend (`node --env-file=.env server/index.js`)
PORT=
NODE_ENV=
DATABASE_URL=
DATABASE_SSL=
VD_SESSION_SECRET=
VD_BCRYPT_COST=
VD_COOKIE_SAMESITE=
VD_COOKIE_SECURE=
# Only needed when the frontend is served from a different origin
VD_FRONTEND_ORIGIN=

# User-run scripts only (never set these in production runtime)
VD_SEED_EMAIL=
VD_SEED_HASH=

# Optional: connection string supplied by the user for tests/auth-db.test.js
TEST_DATABASE_URL=
