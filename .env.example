# Environment variable NAMES only — no values. See README.md for setup.
# Node-RED backend
PORT=
NODE_ENV=
DATABASE_URL=
DATABASE_SSL=
VD_SESSION_SECRET=
VD_CREDENTIAL_SECRET=
VD_BCRYPT_COST=
VD_COOKIE_SAMESITE=
VD_COOKIE_SECURE=
VD_FRONTEND_ORIGIN=
# Local editor only (never ENABLE_EDITOR=true in production)
ENABLE_EDITOR=
VD_ADMIN_USER=
VD_ADMIN_HASH=

# User-run scripts only
VD_SEED_EMAIL=
VD_SEED_HASH=

# Optional: connection string supplied by the user for tests/auth-db.test.js
TEST_DATABASE_URL=
